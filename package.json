{
  "name": "frontend-gnimty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run gen:theme-typings",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "test": "vitest",
    "format": "prettier \"**/*.{ts,tsx,js,css,json,yml,md}\" --write",
    "format:check": "prettier \"**/*.{ts,tsx,js,css,json,yml,md}\" --check",
    "type:check": "tsc",
    "gen:theme-typings": "chakra-cli tokens ./src/styles/theme/chakraTheme.ts"
  },
  "dependencies": {
    "@chakra-ui/anatomy": "^2.2.2",
    "@chakra-ui/next-js": "^2.4.2",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@next/third-parties": "^15.5.19",
    "@stomp/stompjs": "^7.0.0",
    "@tanstack/react-query": "^5.35.5",
    "axios": "^1.6.8",
    "constate": "^3.3.2",
    "dayjs": "^1.11.11",
    "framer-motion": "^11.1.9",
    "next": "^15.5.19",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sharp": "^0.33.3",
    "zustand": "5.0.0-alpha.6"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^2.4.1",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20.12.11",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "braces": "^3.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.19",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.1",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.6"
  }
}
